{% comment %}
Modern project card template for bibliography entries
Usage: {% include project_card.liquid entry=entry %}
{% endcomment %}

<div class="project-card">
  <!-- Visual Abstract / Thumbnail -->
  {% if entry.preview %}
    <button type="button" class="card-image" data-lightbox-caption="{{ entry.title | escape }}" aria-label="Enlarge figure: {{ entry.title | escape }}">
      {% if entry.preview contains '://' %}
        <img src="{{ entry.preview }}" alt="{{ entry.title | truncate: 60 }}" class="card-thumbnail">
      {% else %}
        {% assign image_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        <img src="{{ image_path | relative_url }}" alt="{{ entry.title | truncate: 60 }}" class="card-thumbnail" loading="lazy">
      {% endif %}
      <span class="zoom-hint" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
          <path d="M8.5 1.5h4v4M5.5 12.5h-4v-4M12.5 1.5L8 6M1.5 12.5L6 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </button>
  {% endif %}

  <div class="card-body">
  <!-- Header Section -->
  <div class="card-header">
    <div class="venue-info venue-label">
      {% if entry.venue %}
        {{ entry.venue }}
      {% endif %}
    </div>
    
    <div class="card-tags">
      {% if entry.abbr %}
        <span class="tag">{{ entry.abbr }}</span>
      {% endif %}
      {% if entry.tags %}
        {% assign tag_list = entry.tags | split: ',' %}
        {% for tag in tag_list %}
          <span class="tag">{{ tag | strip }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <!-- Title -->
  <h3 class="card-title">{{ entry.title }}</h3>

  <!-- Authors -->
  <div class="card-authors">
    {% assign author_array_size = entry.author_array | size %}
    {% assign author_array_limit = author_array_size %}
    {% if site.max_author_limit and author_array_size > site.max_author_limit %}
      {% assign author_array_limit = site.max_author_limit %}
    {% endif %}

    {%- for author in entry.author_array limit: author_array_limit -%}
      {% assign author_is_self = false %}
      {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
      {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
      {% if site.scholar.last_name contains author_last_name %}
        {% if site.scholar.first_name contains author.first %}
          {% assign author_is_self = true %}
        {% endif %}
      {%- endif -%}
      
      {%- if forloop.length > 1 -%}
        {% if forloop.first == false %}, {% endif %}
        {%- if forloop.last and author_array_limit == author_array_size %} and {% endif -%}
      {% endif %}
      
      {%- if author_is_self -%}
        <span class="author-self">{{ author.first }} {{ author_last_html }}</span>
      {%- else -%}
        {{ author.first }} {{ author_last_html }}
      {%- endif -%}
    {% endfor %}
  </div>

  <!-- One-sentence Summary -->
  {% if entry.summary %}
    <p class="card-summary">{{ entry.summary | truncate: 200 }}</p>
  {% endif %}

  <!-- Award Badge -->
  {% if entry.award %}
    <div class="award-badge">
      {%- if entry.award_name -%}
        {{ entry.award_name }}
      {%- else -%}
        BEST PAPER HONORABLE MENTION
      {%- endif -%}
    </div>
  {% endif %}

  <!-- Action Links -->
  <div class="card-links">
    {% if entry.pdf %}
      <a href="{{ entry.pdf | prepend: '/assets/pdf/' }}" 
         class="action-btn" target="_blank" rel="noopener noreferrer">
        <i class="fa-regular fa-file-lines" aria-hidden="true"></i>
        <span>PDF</span>
      </a>
    {% endif %}

    {% if entry.demo %}
      <a href="{{ entry.demo }}" class="action-btn" target="_blank" rel="noopener noreferrer">
        <span>Demo</span>
      </a>
    {% elsif entry.website %}
      <a href="{{ entry.website }}" class="action-btn" target="_blank" rel="noopener noreferrer">
        <span>Demo</span>
      </a>
    {% endif %}

    {% if entry.code %}
      <a href="{{ entry.code }}" class="action-btn" target="_blank" rel="noopener noreferrer">
        <i class="fa-brands fa-github" aria-hidden="true"></i>
        <span>Code</span>
      </a>
    {% endif %}

    {% if entry.poster %}
      <a href="{% if entry.poster contains '://' %}{{ entry.poster }}{% else %}{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}{% endif %}" 
         class="action-btn" target="_blank" rel="noopener noreferrer">
        <span>Poster</span>
      </a>
    {% endif %}

    {% if entry.slides %}
      <a href="{% if entry.slides contains '://' %}{{ entry.slides }}{% else %}{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}{% endif %}" 
         class="action-btn" target="_blank" rel="noopener noreferrer">
        <span>Slides</span>
      </a>
    {% endif %}

    {% if entry.doi %}
      <a href="{% if entry.doi contains '://' %}{{ entry.doi }}{% else %}https://doi.org/{{ entry.doi }}{% endif %}" class="action-btn" target="_blank" rel="noopener noreferrer">
        <i class="fa-solid fa-link" aria-hidden="true"></i>
        <span>DOI</span>
      </a>
    {% endif %}

    {% if entry.arxiv %}
      <a href="{{ entry.arxiv }}" class="action-btn" target="_blank" rel="noopener noreferrer">
        <span>arXiv</span>
      </a>
    {% endif %}

    <button type="button" class="action-btn card-toggle" aria-expanded="false" aria-controls="bib-{{ entry.key }}">
      <i class="fa-solid fa-pencil" aria-hidden="true"></i>
      <span>BibTeX</span>
    </button>
  </div>
  </div>

  <!-- Full-width row below text and figure, so opening it never moves the figure -->
  <div class="card-panel card-bibtex" id="bib-{{ entry.key }}" hidden>
    <pre><code>{{ entry.bibtex | hideCustomBibtex | strip }}</code></pre>
    <button type="button" class="copy-bibtex">Copy</button>
  </div>
</div>
