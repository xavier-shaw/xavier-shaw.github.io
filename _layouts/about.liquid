---
layout: default
---
<div class="about">
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-J71LVVLKDE"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-J71LVVLKDE');
  </script>

  <article>
    <section class="intro">
      <aside class="identity">
        {% assign photos = page.profile.gallery %}
        {% if photos == nil and page.profile.image %}
          {% assign photos = page.profile.image | split: '|' %}
        {% endif %}
        {% assign photo_count = photos | size %}
        {% if photo_count > 0 %}
          {% assign start_index = page.profile.gallery_start | default: 1 | minus: 1 | at_least: 0 | at_most: photo_count | modulo: photo_count %}
          <div class="photo-stack{% if photo_count > 1 %} is-gallery{% endif %}" data-count="{{ photo_count }}" data-start="{{ start_index }}">
            {% for photo in photos %}
              {% assign photo_file = photo.image | default: photo %}
              {% assign photo_path = photo_file | prepend: 'assets/img/' %}
              {% assign card_pos = forloop.index0 | minus: start_index | plus: photo_count | modulo: photo_count %}
              <div class="stack-card" data-pos="{{ card_pos }}">
                {%
                  include figure.liquid loading="eager" path=photo_path class="portrait" sizes="260px" alt=photo.alt
                  cache_bust=true
                %}
              </div>
            {% endfor %}
            {% if photo_count > 1 %}
              <button type="button" class="stack-nav stack-prev" aria-label="Previous photo">
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M7.5 2.5L4 6l3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button type="button" class="stack-nav stack-next" aria-label="Next photo">
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M4.5 2.5L8 6l-3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            {% endif %}
          </div>
          {% if photo_count > 1 %}
            <div class="stack-dots" role="group" aria-label="Choose photo">
              {% for photo in photos %}
                <button type="button" class="stack-dot" data-index="{{ forloop.index0 }}" aria-label="Show photo {{ forloop.index }}{% if photo.caption %}: {{ photo.caption }}{% endif %}">
                  {%- if photo.caption -%}<span class="dot-label">{{ photo.caption }}</span>{%- endif -%}
                </button>
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}

        {% if page.profile.email %}
          <a class="identity-email" href="mailto:{{ page.profile.email }}">
            <i class="fa-regular fa-envelope" aria-hidden="true"></i>
            <span>{{ page.profile.email }}</span>
          </a>
        {% endif %}

        <nav class="identity-links" aria-label="Profiles">
          {% for link in page.profile.links %}
            <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">
              {% if link.icon %}<i class="{{ link.icon }}" aria-hidden="true"></i>{% endif %}
              <span>{{ link.name }}</span>
              <svg class="arrow" width="9" height="9" viewBox="0 0 9 9" fill="none" aria-hidden="true">
                <path d="M8 1L1 8M2.4 1H8M8 6.6V1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              </svg>
            </a>
          {% endfor %}
        </nav>
      </aside>

      <div class="bio">
        <h1>{{ site.first_name }} {{ site.last_name }}</h1>
        {% if page.name_native or page.name_pronunciation %}
          <p class="name-native">
            {% if page.name_pronunciation %}<span class="pronounce">Pronounced “{{ page.name_pronunciation }}”</span>{% endif %}
            {% if page.name_native and page.name_pronunciation %}<span class="sep" aria-hidden="true">·</span>{% endif %}
            {% if page.name_native %}<span class="native" lang="zh-Hans">{{ page.name_native }}</span>{% endif %}
          </p>
        {% endif %}
        {% if page.affiliations %}
          <dl class="affiliations">
            {% for group in page.affiliations %}
              <div class="affiliation-row{% if group.current %} is-current{% endif %}">
                {% if group.label %}<dt>{{ group.label }}</dt>{% endif %}
                <dd>
                  {% for org in group.orgs %}
                    {% capture org_label %}{% if org.icon %}<img class="org-icon" src="{{ org.icon | prepend: '/assets/img/' | relative_url }}" alt="" width="16" height="16">{% endif %}<span>{{ org.name }}</span>{% endcapture %}
                    {% if org.url %}<a class="org" href="{{ org.url }}" target="_blank" rel="noopener noreferrer">{{ org_label }}</a>{% else %}<span class="org">{{ org_label }}</span>{% endif %}
                    {%- unless forloop.last %}<span class="sep" aria-hidden="true"> · </span>{% endunless %}
                  {% endfor %}
                </dd>
              </div>
            {% endfor %}
          </dl>
        {% elsif page.subtitle %}
          <p class="subtitle">{{ page.subtitle }}</p>
        {% endif %}
        {{ content }}
      </div>
    </section>

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <section class="home-section">
        <h2>News</h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section">
        <div class="section-head">
          <h2>Research</h2>
          <a href="{{ '/publications/' | relative_url }}">All publications</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <section class="home-section">
        <h2><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
